# --------------------------------------------------------------------------
# EduManager environment configuration
# Copy this file to ".env.local" and fill in real values. Never commit secrets.
# --------------------------------------------------------------------------

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edumanager?schema=public"

# Separate database used by the integration tests (auto-created/migrated/seeded).
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edumanager_test?schema=public"

# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-secret-string"

# Session lifetime (e.g. 7d, 12h)
JWT_EXPIRES="7d"

# Where uploaded submission files are stored (relative to project root)
UPLOAD_DIR="public/uploads"

# Maximum upload size in megabytes
MAX_UPLOAD_MB="10"

# Public-facing application / brand name
NEXT_PUBLIC_APP_NAME="EduManager"

# SMTP / email (e.g. Gmail with an app password). Used for password-reset emails.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=you@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM="EduManager <you@gmail.com>"
